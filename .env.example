# ─── Shared infra (read by docker-compose AND services) ───
NODE_ENV=development

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dispatch
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dispatch

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/

# ─── Secrets (required in production via assertProdSecrets) ───
JWT_SECRET=dev-jwt-secret-change-in-production
INTER_SERVICE_SECRET=dev-inter-service-secret-min-32-chars-long

# ─── Optional ───
# METRICS_TOKEN=        # if set, required as X-Metrics-Token on /metrics
LOG_LEVEL=debug

# ─── Service ports ───
GATEWAY_PORT=4000
AUTH_PORT=3001
ORDER_PORT=3002
LOCATION_HTTP_PORT=3003
REALTIME_PORT=3004
DISPATCH_PORT=3005
AUTH_GRPC_PORT=50052
LOCATION_GRPC_PORT=50051
