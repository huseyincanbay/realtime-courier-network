{
  "name": "realtime-courier-network",
  "version": "0.1.0",
  "description": "Event-driven courier dispatch platform",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev:auth": "pnpm --filter @rcn/auth-service dev",
    "dev:gateway": "pnpm --filter @rcn/gateway dev",
    "dev:order": "pnpm --filter @rcn/order-service dev",
    "dev:location": "pnpm --filter @rcn/location-service dev",
    "dev:dispatch": "pnpm --filter @rcn/dispatch-service dev",
    "start:infra": "docker compose up -d",
    "stop:infra": "docker compose down",
    "lint": "eslint \"{apps,packages}/**/*.ts\"",
    "format": "prettier --write \"{apps,packages}/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
